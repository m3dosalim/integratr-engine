# Copy this file to .env and fill in real provider keys before model calls.
# The shell refuses to start if DATABASE_URL, the LiteLLM URL, the master key,
# the public Engine URL, or the admin token is empty.

LITELLM_MASTER_KEY=sk-engine-master-change-me
ENGINE_ADMIN_TOKEN=change-me-admin-token

# Pipes call this URL for model traffic. On a laptop that is the published proxy port.
ENGINE_BASE_URL=http://localhost:4000

# Aliases in engine/litellm.config.yaml read these names.
# Placeholder keys let the proxy boot. A real call needs a real key.
CHAT_DEFAULT_MODEL=openai/gpt-4o-mini
CHAT_DEFAULT_API_KEY=sk-not-set
IMAGE_DEFAULT_MODEL=openai/gpt-image-1
IMAGE_DEFAULT_API_KEY=sk-not-set
EMBED_DEFAULT_MODEL=openai/text-embedding-3-small
EMBED_DEFAULT_API_KEY=sk-not-set
SPEECH_DEFAULT_MODEL=openai/tts-1
SPEECH_DEFAULT_API_KEY=sk-not-set
TRANSCRIBE_DEFAULT_MODEL=openai/whisper-1
TRANSCRIBE_DEFAULT_API_KEY=sk-not-set
